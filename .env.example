# Supabase project settings — find these in your Supabase project's
# Settings > API page. Copy this file to .env.local and fill in your values.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Used only by scripts/seed.ts (never shipped to the browser). Find it on
# the same Settings > API page, under "service_role" — keep it secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
